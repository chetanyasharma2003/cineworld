# CineWorld Environment Variables

# === DATABASE ===
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/cineworld

# === AUTHENTICATION ===
JWT_SECRET=your_super_secret_jwt_key_32_chars_minimum_required_here
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# === API KEYS ===
TMDB_API_KEY=your_tmdb_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
METRICS_API_KEY=your_secure_metrics_key_here

# === STRIPE (Monetization) ===
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# === EMAIL ===
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=noreply@cineworld.app

# === ERROR TRACKING ===
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# === SERVER ===
NODE_ENV=production
PORT=8000
HOST=0.0.0.0

# === CLIENT ===
CLIENT_ORIGIN=https://cineworld.vercel.app
VITE_API_URL=https://your-render-app.onrender.com

# === OPTIONAL ===
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
API_KEYS=key1,key2,key3
